{
  "name": "@dendelion/func-ui",
  "version": "0.1.1",
  "description": "Glossy, noisy, cosy React component library — frosted glass, film grain, and lava glow",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "packageManager": "pnpm@10.12.1",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./tailwind": {
      "types": "./tailwind.ts",
      "import": "./tailwind.ts",
      "require": "./tailwind.ts"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "tailwind.ts",
    "tailwind.config.js",
    "postcss.config.js",
    "src/globals.scss",
    "src/styles",
    "public/fonts",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:showcase": "vite build --config vite.app.config.ts",
    "preview": "vite preview",
    "check-types": "tsc --noEmit",
    "lint": "biome check ./src && stylelint \"src/**/*.scss\"",
    "lint:fix": "biome check ./src --write && stylelint \"src/**/*.scss\"",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "check-package": "publint",
    "ci": "pnpm run check-types && pnpm run lint && pnpm run build",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adooone/func-ui.git"
  },
  "homepage": "https://github.com/adooone/func-ui#readme",
  "keywords": [
    "react",
    "components",
    "ui",
    "glass",
    "grain",
    "film",
    "funk",
    "tailwindcss",
    "design-system"
  ],
  "author": "Dendelion",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@dendelion/paper-camp": "link:../paper-camp-build",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^3.7.1",
    "autoprefixer": "^10.4.20",
    "gsap": "^3.15.0",
    "postcss": "^8.4.47",
    "postcss-scss": "^4.0.9",
    "publint": "^0.3.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass-embedded": "^1.100.0",
    "stylelint": "^17.14.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@swc/core",
      "esbuild"
    ]
  }
}
